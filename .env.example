# Salin ke .env hanya untuk pengembangan lokal. Jangan pernah commit .env.
# Key produksi disimpan di keychain OS (ADR-0007).

# Lokasi database, worktree, artefak, dan log harness.
# CAECILIA_HOME=~/.caecilia

# API key provider model pertama (prompt 14, keputusan D2).
# Pakai API key provider, bukan login langganan konsumen atau token sesi.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
